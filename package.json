{
  "name": "finora",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "turbo run android --filter=@finora/mobile",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@finora/api",
    "build:mcp": "turbo run build --filter=@finora/mcp",
    "build:web": "turbo run build --filter=@finora/web",
    "check": "oxlint && oxfmt --write",
    "check-types": "turbo run check-types",
    "db:push": "pnpm --filter @finora/api db:push",
    "deploy:api": "turbo run deploy --filter=@finora/api",
    "deploy:mcp": "turbo run deploy --filter=@finora/mcp",
    "dev": "turbo run dev dev:lan",
    "dev:api": "turbo run dev --filter=@finora/api",
    "dev:lan": "turbo run dev:lan --filter=@finora/api",
    "dev:mcp": "turbo run dev --filter=@finora/mcp",
    "dev:mobile": "turbo run dev --filter=@finora/mobile -- --clear",
    "dev:web": "turbo run dev --filter=@finora/web",
    "ios": "turbo run ios --filter=@finora/mobile",
    "postinstall": "node scripts/link-mobile-deps.mjs",
    "preview:web": "turbo run start --filter=@finora/web"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@finora/config": "workspace:*",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0"
}
