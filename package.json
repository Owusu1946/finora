{
  "name": "finora",
  "private": true,
  "version": "0.0.0",
  "description": "Finora — financial operating system for AI agents",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-mobile-deps.mjs",
    "mobile": "bun run --filter @finora/mobile start",
    "mobile:android": "bun run --filter @finora/mobile android",
    "mobile:ios": "bun run --filter @finora/mobile ios",
    "mobile:web": "bun run --filter @finora/mobile web",
    "api": "bun run --filter @finora/api dev",
    "api:deploy": "bun run --filter @finora/api deploy",
    "mcp": "bun run --filter @finora/mcp dev",
    "mcp:deploy": "bun run --filter @finora/mcp deploy",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "lint": "bun run --workspaces --if-present lint"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lightningcss": "1.30.1"
  }
}
