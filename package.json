{
  "name": "finora",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "turbo run android -F mobile",
    "build": "turbo run build",
    "check": "oxlint && oxfmt --write",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "ios": "turbo run ios -F mobile",
    "mobile": "turbo run start -F apps/mobile",
    "postinstall": "node scripts/link-mobile-deps.mjs",
    "web": "turbo run web -F mobile"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@finora/config": "workspace:*",
    "@types/node": "^22.20.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "lightningcss": "1.30.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0"
}
