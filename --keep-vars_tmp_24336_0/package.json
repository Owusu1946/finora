{
  "name": "@finora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --include-runtime=false",
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --inspector-port 9230",
    "dev:lan": "node ./scripts/lan-proxy.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.41",
    "@ai-sdk/provider": "4.0.7",
    "@clerk/backend": "3.16.3",
    "@clerk/hono": "^0.1.64",
    "@finora/env": "workspace:*",
    "@finora/shared": "workspace:*",
    "@finora/wewire": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "7.0.65",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "mammoth": "1.12.1",
    "react": "19.1.0",
    "react-email": "^6.9.2",
    "redis": "6.2.1",
    "resend": "^6.19.0",
    "resumable-stream": "2.2.12",
    "unpdf": "1.8.1",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/react": "^19.2.18",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
